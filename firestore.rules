rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // MODO MASTER: quem digitou a senha master (documento masters/{uid}, que a
    // regra só grava se a senha bater com config/master, doc que NENHUM cliente
    // lê) enxerga e administra todas as igrejas. A senha é conferida de novo
    // a cada acesso: trocar config/master.senha no console derruba todos os
    // masters na hora.
    function isMaster() {
      return logado() &&
        exists(/databases/$(database)/documents/masters/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/masters/$(request.auth.uid)).data.senha ==
          get(/databases/$(database)/documents/config/master).data.senha;
    }

    // Membro "de verdade" (tem documento em usuarios). Separado de ehMembro
    // porque membro()/papel() só funcionam quando esse documento existe.
    function ehMembroReal(igrejaId) {
      return logado() &&
        exists(/databases/$(database)/documents/igrejas/$(igrejaId)/usuarios/$(request.auth.uid));
    }

    function ehMembro(igrejaId) {
      return isMaster() || ehMembroReal(igrejaId);
    }

    function membro(igrejaId) {
      return get(/databases/$(database)/documents/igrejas/$(igrejaId)/usuarios/$(request.auth.uid)).data;
    }

    function papel(igrejaId) {
      return membro(igrejaId).papel;
    }

    function isAdmin(igrejaId) {
      return isMaster() || (ehMembroReal(igrejaId) && papel(igrejaId) == 'admin');
    }

    // Contas criadas antes do sistema de permissão por aba não têm o campo
    // abasPermitidas — nesse caso, tratamos como acesso total (não quebra
    // quem já estava usando o app).
    function abasDoMembro(igrejaId) {
      return membro(igrejaId).abasPermitidas != null
        ? membro(igrejaId).abasPermitidas
        : ['lancamentos','fieis','cadastros','relatorios','competencias'];
    }

    function temAcessoAba(igrejaId, aba) {
      return isAdmin(igrejaId) || (ehMembro(igrejaId) && aba in abasDoMembro(igrejaId));
    }

    function podeEditar(igrejaId) {
      return isMaster() || (ehMembroReal(igrejaId) && (papel(igrejaId) == 'admin' || papel(igrejaId) == 'cadastrador'));
    }

    function podeEditarAba(igrejaId, aba) {
      return temAcessoAba(igrejaId, aba) && podeEditar(igrejaId);
    }

    function conviteValido(igrejaId) {
      return logado() &&
        exists(/databases/$(database)/documents/igrejas/$(igrejaId)/convites/$(request.auth.token.email));
    }

    // Verifica de verdade se a competência está bloqueada, consultando a
    // coleção "competencias" (fonte única da verdade) através do campo
    // competenciaKey já salvo no próprio lançamento — evita ter que montar
    // a chave "AAAA-MM" manualmente na regra.
    function competenciaBloqueada(igrejaId, chave) {
      return chave != null &&
        exists(/databases/$(database)/documents/igrejas/$(igrejaId)/competencias/$(chave)) &&
        get(/databases/$(database)/documents/igrejas/$(igrejaId)/competencias/$(chave)).data.bloqueado == true;
    }

    // Verifica se a campanha está encerrada (impede novos lançamentos nela,
    // mesmo padrão usado para competências bloqueadas).
    function campanhaEncerrada(igrejaId, campanhaId) {
      return exists(/databases/$(database)/documents/igrejas/$(igrejaId)/campanhas/$(campanhaId)) &&
        get(/databases/$(database)/documents/igrejas/$(igrejaId)/campanhas/$(campanhaId)).data.status == 'encerrada';
    }

    // Perfil pessoal do usuário (nome/e-mail) — só o próprio dono lê/edita.
    // A exclusão é liberada pra qualquer usuário logado porque esse
    // documento guarda só nome+e-mail (sem dados financeiros nem controle
    // de acesso) e se recria sozinho no próximo login — serve pra permitir
    // que um admin limpe o registro de alguém que perdeu acesso a todas as
    // igrejas, sem precisar de um servidor próprio pra isso.
    match /perfis/{uid} {
      allow read, update, create: if logado() && request.auth.uid == uid;
      allow delete: if logado();
    }

    // Índice: "em quais igrejas eu estou". Coleção de nível raiz (não é
    // subcoleção, e não usamos collectionGroup) para permitir uma consulta
    // simples e segura por uid, sem depender de checagem cruzada de outro
    // documento — o Firestore não lida bem com isso em buscas amplas.
    // Criar o próprio índice só com convite antigo válido; o admin (ou master)
    // cria o índice de quem ele cadastra. A antiga brecha "!exists(usuarios)"
    // saiu: com ela qualquer logado se anunciava como membro de qualquer igreja.
    match /membrosIndice/{docId} {
      allow read: if logado() && resource.data.uid == request.auth.uid;
      allow create: if logado() && request.auth.uid == request.resource.data.uid &&
        exists(/databases/$(database)/documents/igrejas/$(request.resource.data.igrejaId)/convites/$(request.auth.token.email))
        || isAdmin(request.resource.data.igrejaId);
      allow update: if isAdmin(resource.data.igrejaId) ||
        (logado() && resource.data.uid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['precisaTrocarSenha']));
      allow delete: if logado() && (resource.data.uid == request.auth.uid || isAdmin(resource.data.igrejaId));
    }

    // Índice: "existe convite pendente pra mim". Mesmo raciocínio acima.
    match /convitesIndice/{docId} {
      allow read: if logado() && resource.data.email == request.auth.token.email;
      allow create: if isAdmin(request.resource.data.igrejaId);
      allow delete: if logado() && (resource.data.email == request.auth.token.email || isAdmin(resource.data.igrejaId));
    }

    // Ativação do modo master. Só grava se a senha digitada bater com a de
    // config/master. Cada um lê/apaga apenas o próprio documento (sair do modo).
    match /masters/{uid} {
      allow read, delete: if logado() && request.auth.uid == uid;
      allow create, update: if logado() && request.auth.uid == uid &&
        request.resource.data.senha ==
          get(/databases/$(database)/documents/config/master).data.senha;
    }

    // Guarda a senha master (campo "senha"), criada à mão no console do
    // Firebase. Nenhum cliente lê nem grava aqui.
    match /config/{docId} {
      allow read, write: if false;
    }

    // "Qual é o uid deste e-mail?" — gravado pelo próprio usuário a cada login.
    // Permite ao admin dar acesso direto a quem já tem conta, sem convite e
    // sem servidor. Só leitura pontual (get): ninguém lista a coleção.
    match /usuariosPorEmail/{email} {
      allow get: if logado();
      allow list: if false;
      allow create, update: if logado() &&
        request.auth.token.email.lower() == email &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /igrejas/{igrejaId} {
      allow read: if ehMembro(igrejaId);
      // Só o master cria igreja. Administradores comuns administram apenas a
      // sua (usuários, dados, exclusão).
      allow create: if isMaster();
      allow update: if isAdmin(igrejaId);
      // Exclusão só por admin (ou master). A regra de "sem lançamentos" é
      // checada pelo app antes de apagar; a regra aqui garante que só admin chega lá.
      allow delete: if isAdmin(igrejaId);

      match /usuarios/{uid} {
        allow read: if ehMembro(igrejaId);
        // O admin da igreja (ou o master) cadastra o usuário já com acesso
        // direto. O próprio usuário só cria o vínculo por convite antigo
        // (resgate de convites pendentes de versões anteriores).
        allow create: if logado() && request.auth.uid == uid && conviteValido(igrejaId)
          || isAdmin(igrejaId);
        allow update: if isAdmin(igrejaId) ||
          (logado() && request.auth.uid == uid &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['precisaTrocarSenha']));
        allow delete: if isAdmin(igrejaId) || (logado() && request.auth.uid == uid);
      }

      match /convites/{email} {
        allow read: if isAdmin(igrejaId) || (logado() && request.auth.token.email == email);
        allow create, update: if isAdmin(igrejaId);
        // O convidado precisa apagar o próprio convite ao resgatá-lo; sem isso
        // o convite ficava pendente na lista do admin para sempre.
        allow delete: if isAdmin(igrejaId) || (logado() && request.auth.token.email == email);
      }

      match /membros/{docId} {
        // 'agendas' também lê: o seletor de escalas busca quem participa da programação.
        allow read: if temAcessoAba(igrejaId, 'fieis') || temAcessoAba(igrejaId, 'agendas');
        allow write: if podeEditarAba(igrejaId, 'fieis');
      }

      match /grupos/{docId} {
        allow read: if temAcessoAba(igrejaId, 'cadastros');
        allow write: if podeEditarAba(igrejaId, 'cadastros');
      }

      match /cargos/{docId} {
        allow read: if temAcessoAba(igrejaId, 'cadastros');
        allow write: if podeEditarAba(igrejaId, 'cadastros');
      }

      match /categoriasReceita/{docId} {
        allow read: if temAcessoAba(igrejaId, 'cadastros');
        allow write: if podeEditarAba(igrejaId, 'cadastros');
      }

      match /categoriasDespesa/{docId} {
        allow read: if temAcessoAba(igrejaId, 'cadastros');
        allow write: if podeEditarAba(igrejaId, 'cadastros');
      }

      // Conciliação bancária: quem tem a aba "financeiro" pode alterar SOMENTE
      // os campos de conciliação de um lançamento (mesmo em competência
      // bloqueada — conciliar não muda o valor). Já um lançamento conciliado
      // não pode ser editado nem excluído por quem só tem "lancamentos":
      // precisa desconciliar antes. (get(...) trata lançamentos antigos sem o campo.)
      match /lancamentos/{docId} {
        allow read: if temAcessoAba(igrejaId, 'lancamentos') || temAcessoAba(igrejaId, 'financeiro');
        allow create: if podeEditarAba(igrejaId, 'lancamentos') &&
          !competenciaBloqueada(igrejaId, request.resource.data.competenciaKey);
        allow update: if (
            podeEditarAba(igrejaId, 'lancamentos') &&
            resource.data.get('conciliado', false) != true &&
            !competenciaBloqueada(igrejaId, resource.data.competenciaKey) &&
            !competenciaBloqueada(igrejaId, request.resource.data.competenciaKey)
          ) || (
            podeEditarAba(igrejaId, 'financeiro') &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['conciliado','contaDataConc','conciliadoEm','conciliadoPor'])
          );
        allow delete: if podeEditarAba(igrejaId, 'lancamentos') &&
          resource.data.get('conciliado', false) != true &&
          !competenciaBloqueada(igrejaId, resource.data.competenciaKey);
      }

      // Contas bancárias / caixa. Leitura também para quem lança (precisa
      // escolher a conta no lançamento); escrita só com a aba "financeiro".
      // ---- Agendas semanais: tudo sob a aba 'agendas' ----
      match /cultosPadrao/{docId} { allow read: if temAcessoAba(igrejaId, 'agendas'); allow write: if podeEditarAba(igrejaId, 'agendas'); }
      match /agendas/{docId}      { allow read: if temAcessoAba(igrejaId, 'agendas'); allow write: if podeEditarAba(igrejaId, 'agendas'); }
      match /participacoes/{docId}{ allow read: if temAcessoAba(igrejaId, 'agendas'); allow write: if podeEditarAba(igrejaId, 'agendas'); }
      match /lembretes/{docId}    { allow read: if temAcessoAba(igrejaId, 'agendas'); allow write: if podeEditarAba(igrejaId, 'agendas'); }
      match /mensagens/{docId}    { allow read: if temAcessoAba(igrejaId, 'agendas'); allow write: if podeEditarAba(igrejaId, 'agendas'); }
      match /configAgenda/{docId} { allow read: if temAcessoAba(igrejaId, 'agendas'); allow write: if podeEditarAba(igrejaId, 'agendas'); }

      match /contas/{contaId} {
        allow read: if temAcessoAba(igrejaId, 'lancamentos') || temAcessoAba(igrejaId, 'financeiro');
        allow write: if podeEditarAba(igrejaId, 'financeiro');
      }

      match /competencias/{docId} {
        allow read: if temAcessoAba(igrejaId, 'competencias');
        allow write: if isAdmin(igrejaId);
      }

      match /campanhas/{campanhaId} {
        allow read: if temAcessoAba(igrejaId, 'campanhas');
        allow write: if podeEditarAba(igrejaId, 'campanhas');

        match /lancamentos/{lancId} {
          allow read: if temAcessoAba(igrejaId, 'campanhas');
          allow create, update, delete: if podeEditarAba(igrejaId, 'campanhas') &&
            !campanhaEncerrada(igrejaId, campanhaId);
        }
      }
    }
  }
}
